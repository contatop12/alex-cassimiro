# ─────────────────────────────────────────────────────────────
# Variáveis de BUILD (lidas por scripts/build.ts) — públicas, vão para o HTML
# ─────────────────────────────────────────────────────────────
# Domínio canônico usado em canonical, hreflang, sitemap, OG e JSON-LD
SITE_URL=https://alexcassimiro.com.br
# Google Tag Manager (opcional). Sem valor: nenhum script de analytics e nenhum banner de consentimento.
PUBLIC_GTM_ID=
# Cloudflare Turnstile — chave PÚBLICA do widget (opcional; exige TURNSTILE_SECRET_KEY no Worker)
PUBLIC_TURNSTILE_SITE_KEY=
# Defina como 1 para gerar uma prévia com <meta name="robots" content="noindex"> em todas as páginas
PUBLIC_NOINDEX=

# ─────────────────────────────────────────────────────────────
# Variáveis/SEGREDOS do WORKER (formulário /api/lead)
# Local: copie para .dev.vars  ·  Produção: `npx wrangler secret put NOME`
# ─────────────────────────────────────────────────────────────
# Destino dos pedidos de proposta (var pública em wrangler.jsonc)
LEAD_TO_EMAIL=oalexcassimiro@gmail.com
# Remetente VERIFICADO no provedor de e-mail (ex.: propostas@alexcassimiro.com.br)
LEAD_FROM_EMAIL=
# Resend (https://resend.com) — segredo
RESEND_API_KEY=
# Webhook opcional (n8n, Make, CRM). Recebe o lead em JSON via POST — segredo
LEAD_WEBHOOK_URL=
# Cabeçalho de autorização opcional enviado ao webhook (ex.: "Bearer xxx") — segredo
LEAD_WEBHOOK_AUTH=
# Cloudflare Turnstile — chave SECRETA (opcional) — segredo
TURNSTILE_SECRET_KEY=
